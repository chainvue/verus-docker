#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# `verus` CLI wrapper.
#
# The point of this wrapper is that `docker exec <container> verus getinfo`
# works with zero configuration, on every chain. It injects the -chain flag
# derived from the container's CHAIN env var, and — for PBaaS chains only —
# the RPC credentials, because a PBaaS daemon writes its own config file
# containing a random password we do not control.
#
# The real client stays available at /opt/verus-cli/verus if you need it raw.

set -euo pipefail

readonly LIB_DIR="/usr/local/lib/verus"
# shellcheck source=../lib/verus/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/verus/chain.sh
source "${LIB_DIR}/chain.sh"

readonly VERUS_BIN="/opt/verus-cli/verus"

main() {
	local -a args=()
	local creds_file

	resolve_chain

	[[ "$CHAIN_NAME" == "VRSC" ]] || args+=("-chain=${CHAIN_NAME}")

	if [[ "$CHAIN_KIND" == "pbaas" ]]; then
		# A PBaaS chain's config file lives in a directory named after a hash
		# the daemon derives at runtime, and verusd populates it with its own
		# random rpcpassword. The client would therefore authenticate with the
		# wrong credentials, so we pass ours explicitly.
		creds_file="$(chain_credentials_file)"
		if [[ -r "$creds_file" ]]; then
			# shellcheck disable=SC1090  # runtime path, generated at startup
			source "$creds_file"
			args+=(
				"-rpcuser=${RPC_USER}"
				"-rpcpassword=${RPC_PASSWORD}"
				"-rpcport=${RPC_PORT}"
			)
		else
			log_warn "no credentials file at ${creds_file}; falling back to the daemon's own config"
		fi
	fi

	exec "$VERUS_BIN" "${args[@]}" "$@"
}

main "$@"
