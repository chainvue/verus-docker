# =============================================================================
# verus-docker configuration
#
# Copy to .env and edit. Every variable is optional; the defaults shown are what
# the container uses when the variable is unset.
#
# Defaults are chosen to be safe first and convenient second. Where a default is
# developer-friendly but needs thought in production, it says so.
# =============================================================================

# -----------------------------------------------------------------------------
# Chain selection
# -----------------------------------------------------------------------------

# Which chain to run. VRSC (mainnet), VRSCTEST (testnet), or ANY PBaaS chain
# name or i-address — there is no whitelist. PBaaS chains additionally need a
# root node; see the PBaaS section below.
CHAIN=VRSC

# The root chain a PBaaS chain belongs to. Only meaningful when CHAIN is a
# PBaaS chain. Controls whether data lands in ~/.verus or ~/.verustest.
#ROOT_CHAIN=VRSC

# -----------------------------------------------------------------------------
# File ownership (host bind mounts only)
# -----------------------------------------------------------------------------

# The image runs as uid/gid 1000 and never needs root. If you bind-mount a host
# directory owned by a different user, start the container as root and set these
# — the entrypoint remaps the verus user, fixes ownership and drops privileges
# before starting the daemon. Named volumes do not need this.
#PUID=1000
#PGID=1000

# -----------------------------------------------------------------------------
# RPC
# -----------------------------------------------------------------------------

# Left unset, cryptographically random credentials are generated on first start
# and written to a 0600 file inside the data volume. The log tells you where.
#RPC_USER=
#RPC_PASSWORD=

# Defaults come from the chain: VRSC 27486/27485, VRSCTEST 18843/18842.
# PBaaS chains have no predictable ports and MUST set both explicitly.
#RPC_PORT=
#P2P_PORT=

# Who may reach the RPC port. "auto" (the default) detects the container's own
# network and allows only that, plus 127.0.0.1.
#
# DANGER: 0.0.0.0/0 exposes a wallet-controlling, unthrottled RPC to anything
# that can route to the container. The entrypoint prints a loud warning if you
# set it. Use an SSH tunnel or a private network instead — see docs/production.md.
#RPC_ALLOW_IP=auto

# -----------------------------------------------------------------------------
# Indexes
#
# These are only ever applied when the config file is first created. Changing
# them later requires a full -reindex, so verus-docker will not silently rewrite
# an existing config.
# -----------------------------------------------------------------------------

# Transaction index. Default ON because developers expect full tx lookup.
# It costs disk. Pure staking nodes can set this to 0 before first start.
TXINDEX=1

#IDINDEX=false
#TIMESTAMPINDEX=false
#INSIGHT_EXPLORER=false

# NOTE: addressindex and spentindex are NOT configurable. verusd forces both on
# regardless of what the config says, so budget disk for them either way.

# -----------------------------------------------------------------------------
# Wallet and staking
# -----------------------------------------------------------------------------

# Pure RPC infrastructure? Disable the wallet and the whole key-custody risk
# disappears. Cannot be combined with staking.
#DISABLE_WALLET=false

# Stake with the wallet's balance (-mint). Read docs/staking.md first: a staking
# node holds spendable keys and its RPC must never be reachable from outside.
#ENABLE_STAKING=false

# Set to false to silence the wallet backup warning once you have a backup
# routine you trust.
#WALLET_WARNING=true

# -----------------------------------------------------------------------------
# Bootstrap (chain snapshot)
# -----------------------------------------------------------------------------

# Download a snapshot instead of syncing from genesis. OFF by default because it
# is a large download and it replaces chain data. The quickstart turns it on.
# Only ever runs when the data directory has no chain data yet.
#
# verus-docker always verifies the published SHA-256 before extracting, and
# never uses the daemon's own -bootstrap flag (which is destructive on every
# start and performs no verification at all).
USE_BOOTSTRAP=false

# Override the archive URL. A <url>.sha256sum sidecar must exist next to it.
#BOOTSTRAP_URL=

# Some third-party bootstrap hosts serve expired TLS certificates (see
# docs/pbaas.md). The hosts this project ships do not, so you should only need
# this with your own BOOTSTRAP_URL. Setting it skips certificate validation — the SHA-256 check still runs, so corruption is
# still caught, but the server's identity is not authenticated. Opt in knowingly.
#BOOTSTRAP_INSECURE_TLS=false

# -----------------------------------------------------------------------------
# Zcash parameters
#
# Roughly 740 MB, fetched once, hash-verified, and shared by every chain. Put
# them on their own volume so multiple nodes reuse the same copy.
# -----------------------------------------------------------------------------

#PARAMS_SOURCE=https://verus.io/zcparams
#PARAMS_VERIFY_EXISTING=false

# -----------------------------------------------------------------------------
# PBaaS root chain
#
# A PBaaS daemon does not read its chain definition from disk: on startup it
# calls getcurrency on the Verus root chain over plain HTTP. Without a reachable
# root node it exits with "Cannot find blockchain data".
#
# Note that https:// cannot work here — verusd speaks plain HTTP to a host:port
# and cannot use a public gateway such as api.verus.services as its root.
#
# Mounting the root chain's data volume into a PBaaS container is NOT an
# alternative to setting these: the config it contains points at 127.0.0.1,
# which is the PBaaS container itself. That only works when the two share a
# network namespace.
# -----------------------------------------------------------------------------

#ROOT_RPC_URL=http://vrsc:27486
#ROOT_RPC_HOST=vrsc
#ROOT_RPC_PORT=27486
#ROOT_RPC_USER=
#ROOT_RPC_PASSWORD=

# How long to wait for the root chain to answer and catch up before giving up.
#ROOT_WAIT_TIMEOUT=900

# How recent the root chain's tip must be before a PBaaS chain will start.
# Judged on tip age, not verificationprogress, which verusd reports as 1 during
# early sync.
#ROOT_MAX_TIP_AGE=1800

# -----------------------------------------------------------------------------
# Health and readiness
# -----------------------------------------------------------------------------

# How many blocks behind the peers' height still counts as synced.
#SYNCED_TOLERANCE_BLOCKS=2

# How old the chain tip may be and still count as synced, in seconds.
#SYNCED_MAX_TIP_AGE=1800

#HEALTH_FILE=/tmp/health.json

# -----------------------------------------------------------------------------
# Everything else
# -----------------------------------------------------------------------------

# Cap peer connections. Useful in CI and on constrained hosts. Unset means the
# daemon's own default, which is what you want in production — peer starvation
# slows initial sync badly.
#MAX_CONNECTIONS=

# Passed to verusd verbatim, split on whitespace.
#EXTRA_ARGS=

# Verbose entrypoint logging.
#DEBUG=false

# Timeout for the entrypoint's own RPC calls, in seconds.
#RPC_TIMEOUT=60
